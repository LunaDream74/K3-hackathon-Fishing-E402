# Copy this file to codebase/.env and paste your real key.
# codebase/.env is git-ignored — never commit the real key.

OPENAI_API_KEY=sk-...your_openai_key_here...

# Model used for the central AI decision (Step 2+3). gpt-4o-mini is cheap + fast.
PHISHSHIELD_MODEL=gpt-4o-mini

# Set to 1 to force the offline mock LLM (no API calls). Leave unset for real calls.
PHISHSHIELD_MOCK=
